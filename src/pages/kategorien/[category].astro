---
import recipeData from '../../data/das_ferment.json';
import RecipeCard from '../../components/RecipeCard.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { imageForRecipe } from '../../lib/pageImages';
import { categoryLabel, categorySlug, type Recipe } from '../../lib/recipes';
import '../../styles/global.css';

interface Props {
	category: string;
	categoryLabel: string;
	categoryRecipes: Recipe[];
}

export function getStaticPaths() {
	const recipes = recipeData as Recipe[];
	const categoryMap = new Map<string, { label: string; recipes: Recipe[] }>();

	for (const recipe of recipes) {
		for (const tag of recipe.tags) {
			const slug = categorySlug(tag);
			const current = categoryMap.get(slug) ?? { label: categoryLabel(tag), recipes: [] };
			current.recipes.push(recipe);
			categoryMap.set(slug, current);
		}
	}

	return [...categoryMap.entries()].map(([category, { label, recipes: categoryRecipesForPath }]) => ({
		params: { category },
		props: {
			category,
			categoryLabel: label,
			categoryRecipes: categoryRecipesForPath,
		},
	}));
}

const { category, categoryLabel: categoryTitle, categoryRecipes: recipes } = Astro.props;
const canonicalPath = `/kategorien/${category}/`;
const canonicalUrl = Astro.site ? new URL(canonicalPath, Astro.site).toString() : canonicalPath;
const description = `${recipes.length} ${recipes.length === 1 ? 'Rezept' : 'Rezepte'} mit dem Thema ${categoryTitle} im Codex von Das Ferment.`;
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<meta name="theme-color" content="#2b2118" />
		<link rel="canonical" href={canonicalUrl} />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<title>{categoryTitle} | Rezepte | Das Ferment</title>
	</head>
	<body>
		<div class="site-shell">
			<Header />

			<main class="repertoire category-page">
				<nav class="breadcrumbs" aria-label="Brotkrümelnavigation">
					<a href="/">Startseite</a>
					<span aria-hidden="true">/</span>
					<a href="/kategorien/">Kategorien</a>
					<span aria-hidden="true">/</span>
					<span aria-current="page">{categoryTitle}</span>
				</nav>

				<header class="section-heading">
					<div>
						<p class="section-heading__kicker">Kategorie im Codex</p>
						<h1 id="category-title">{categoryTitle}</h1>
					</div>
					<p class="section-heading__count">
						{recipes.length} {recipes.length === 1 ? 'Rezept' : 'Rezepte'} mit diesem Thema.
					</p>
				</header>

				<div class="recipe-grid" aria-labelledby="category-title">
					{recipes.map((recipe, index) => (
						<RecipeCard
							recipe={recipe}
							image={imageForRecipe(recipe)}
							index={index}
							total={recipes.length}
						/>
					))}
				</div>
			</main>

			<Footer />
		</div>
	</body>
</html>
