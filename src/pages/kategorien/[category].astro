---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import recipeData from '../../data/das_ferment.json';
import RecipeCard from '../../components/RecipeCard.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import SeoHead from '../../components/SeoHead.astro';
import { coverImageFor, imageForRecipe } from '../../lib/pageImages';
import { socialCard } from '../../lib/social';
import { categoryLabel, categorySlug, recipeImageAlt, slugify, type Recipe } from '../../lib/recipes';
import '../../styles/global.css';

interface Props {
	category: string;
	categoryLabel: string;
	categoryRecipes: Recipe[];
}

export function getStaticPaths() {
	const recipes = recipeData as Recipe[];
	const categoryMap = new Map<string, { label: string; recipes: Recipe[] }>();

	for (const recipe of recipes) {
		for (const tag of recipe.tags) {
			const slug = categorySlug(tag);
			const current = categoryMap.get(slug) ?? { label: categoryLabel(tag), recipes: [] };
			current.recipes.push(recipe);
			categoryMap.set(slug, current);
		}
	}

	return [...categoryMap.entries()].map(([category, { label, recipes: categoryRecipesForPath }]) => ({
		params: { category },
		props: {
			category,
			categoryLabel: label,
			categoryRecipes: categoryRecipesForPath,
		},
	}));
}

const { category, categoryLabel: categoryTitle, categoryRecipes: recipes } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path}`;
const canonicalPath = `/kategorien/${category}/`;
const canonicalUrl = Astro.site ? new URL(withBase(canonicalPath), Astro.site).toString() : withBase(canonicalPath);
const recipeWord = recipes.length === 1 ? 'Rezept' : 'Rezepte';
const title = `${categoryTitle} fermentieren – ${recipes.length} ${recipeWord} | Das Ferment`;
const description = `${recipes.length} ${recipeWord} zum Fermentieren mit ${categoryTitle} – mit Zutaten, Zubereitung und Buchmalereien aus dem Kodex von Das Ferment.`;
const recipeItems = recipes.map((recipe) => ({
	name: recipe.titel,
	path: `/rezepte/${slugify(recipe.titel)}/`,
}));
const absoluteUrl = (path: string) => Astro.site ? new URL(path, Astro.site).toString() : path;
const coverRecipe = recipes.find((recipe) => imageForRecipe(recipe));
const cover = coverImageFor(recipes);
const cardImage = await socialCard(
	(options) => getImage({ ...options, src: cover as ImageMetadata }),
	cover && coverRecipe
		? {
				width: cover.width,
				height: cover.height,
				alt: recipeImageAlt(coverRecipe),
			}
		: undefined,
	absoluteUrl,
);
---

<!doctype html>
<html lang="de">
	<head>
		<SeoHead
			title={title}
			description={description}
			canonicalUrl={canonicalUrl}
			base={base}
			image={cardImage}
			breadcrumbs={[
				{ name: 'Startseite', path: '/' },
				{ name: 'Kategorien', path: '/kategorien/' },
				{ name: categoryTitle, path: canonicalPath },
			]}
			itemList={{ name: `Rezepte in ${categoryTitle}`, items: recipeItems }}
		/>
	</head>
	<body>
		<div class="site-shell">
			<Header />

			<main class="repertoire category-page">
				<nav class="breadcrumbs" aria-label="Brotkrümelnavigation">
					<a href={withBase('/')}>Startseite</a>
					<span aria-hidden="true">/</span>
					<a href={withBase('/kategorien/')}>Kategorien</a>
					<span aria-hidden="true">/</span>
					<span aria-current="page">{categoryTitle}</span>
				</nav>

				<header class="section-heading">
					<div>
						<p class="section-heading__kicker">Kategorie im Kodex</p>
						<h1 id="category-title">{categoryTitle}</h1>
					</div>
					<p class="section-heading__count">
						{recipes.length} {recipes.length === 1 ? 'Rezept' : 'Rezepte'} mit diesem Thema.
					</p>
				</header>

				<div class="recipe-grid" aria-labelledby="category-title">
					{recipes.map((recipe, index) => (
						<RecipeCard
							recipe={recipe}
							image={imageForRecipe(recipe)}
							index={index}
							total={recipes.length}
						/>
					))}
				</div>
			</main>

			<Footer />
		</div>
	</body>
</html>
