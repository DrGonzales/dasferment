---
import SkipLink from '../../components/SkipLink.astro';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import RecipeCard from '../../components/RecipeCard.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import SeoHead from '../../components/SeoHead.astro';
import { allRecipes, infoPath, recipePath } from '../../lib/chapters';
import {
	landingInfos,
	landingPageForRoute,
	orderedRecipes,
	withCount,
} from '../../lib/landingPages';
import { coverImageFor, imageForRecipe } from '../../lib/pageImages';
import { socialCard } from '../../lib/social';
import { categoryLabel, categorySlug, MIN_CATEGORY_RECIPES, recipeImageAlt, type Recipe } from '../../lib/recipes';
import '../../styles/global.css';

interface Props {
	category: string;
	categoryLabel: string;
	categoryRecipes: Recipe[];
}

export function getStaticPaths() {
	const recipes = allRecipes;
	const categoryMap = new Map<string, { label: string; recipes: Recipe[] }>();

	for (const recipe of recipes) {
		for (const tag of recipe.tags) {
			const slug = categorySlug(tag);
			const current = categoryMap.get(slug) ?? { label: categoryLabel(tag), recipes: [] };
			current.recipes.push(recipe);
			categoryMap.set(slug, current);
		}
	}

	return [...categoryMap.entries()]
		.filter(([, { recipes: categoryRecipesForPath }]) => categoryRecipesForPath.length >= MIN_CATEGORY_RECIPES)
		.map(([category, { label, recipes: categoryRecipesForPath }]) => ({
			params: { category },
			props: {
				category,
				categoryLabel: label,
				categoryRecipes: categoryRecipesForPath,
			},
		}));
}

const { category, categoryLabel: categoryTitle, categoryRecipes: recipes } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path}`;
const canonicalPath = `/kategorien/${category}/`;
const canonicalUrl = Astro.site ? new URL(withBase(canonicalPath), Astro.site).toString() : withBase(canonicalPath);
const recipeWord = recipes.length === 1 ? 'Rezept' : 'Rezepte';
const landing = landingPageForRoute(canonicalPath);
const displayedRecipes = landing ? orderedRecipes(recipes, landing.reihenfolge) : recipes;
const title = landing
	? withCount(landing.title, recipes.length)
	: `${categoryTitle} fermentieren – ${recipes.length} ${recipeWord} | Das Ferment`;
const description = landing
	? withCount(landing.description, recipes.length)
	: `${recipes.length} ${recipeWord} zum Fermentieren mit ${categoryTitle} – mit Zutaten, Zubereitung und Buchmalereien aus dem Kodex von Das Ferment.`;
const pageKicker = landing?.kicker ?? 'Kategorie im Kodex';
const pageTitle = landing?.h1 ?? categoryTitle;
const wissen = landing ? landingInfos(landing) : [];
const recipeItems = displayedRecipes.map((recipe) => ({
	name: recipe.titel,
	path: recipePath(recipe),
}));
const absoluteUrl = (path: string) => Astro.site ? new URL(path, Astro.site).toString() : path;
const coverRecipe = recipes.find((recipe) => imageForRecipe(recipe));
const cover = coverImageFor(recipes);
const cardImage = await socialCard(
	(options) => getImage({ ...options, src: cover as ImageMetadata }),
	cover && coverRecipe
		? {
				width: cover.width,
				height: cover.height,
				alt: recipeImageAlt(coverRecipe),
			}
		: undefined,
	absoluteUrl,
);
---

<!doctype html>
<html lang="de">
	<head>
		<SeoHead
			title={title}
			description={description}
			canonicalUrl={canonicalUrl}
			base={base}
			image={cardImage}
			breadcrumbs={[
				{ name: 'Startseite', path: '/' },
				{ name: 'Kategorien', path: '/kategorien/' },
				{ name: pageTitle, path: canonicalPath },
			]}
			itemList={{ name: `Rezepte in ${categoryTitle}`, items: recipeItems }}
		/>
	</head>
	<body>
		<SkipLink />
		<div class="site-shell">
			<Header />

			<main id="main" class="repertoire category-page">
				<nav class="breadcrumbs" aria-label="Brotkrümelnavigation">
					<a href={withBase('/')}>Startseite</a>
					<span aria-hidden="true">/</span>
					<a href={withBase('/kategorien/')}>Kategorien</a>
					<span aria-hidden="true">/</span>
					<span aria-current="page">{pageTitle}</span>
				</nav>

				<header class="section-heading">
					<div>
						<p class="section-heading__kicker">{pageKicker}</p>
						<h1 id="category-title">{pageTitle}</h1>
					</div>
					<p class="section-heading__count">
						{recipes.length} {recipes.length === 1 ? 'Rezept' : 'Rezepte'} mit diesem Thema.
					</p>
				</header>

				{landing && (
					<div class="landing-intro">
						<p>{landing.lead}</p>
						{wissen.length > 0 && (
							<nav class="landing-wissen" aria-label="Wissen zur Einstiegsseite">
								<p class="section-heading__kicker">Aus dem Wissensteil</p>
								<ul>
									{wissen.map((info) => (
										<li>
											<a class="prose-link" href={withBase(infoPath(info))}>
												{info.titel}
												<span class="prose-link__arrow" aria-hidden="true">↗</span>
											</a>
										</li>
									))}
								</ul>
							</nav>
						)}
					</div>
				)}

				<div class="recipe-grid" aria-labelledby="category-title">
					{displayedRecipes.map((recipe, index) => (
						<RecipeCard
							recipe={recipe}
							image={imageForRecipe(recipe)}
							index={index}
							total={recipes.length}
						/>
					))}
				</div>
			</main>

			<Footer />
		</div>
	</body>
</html>
