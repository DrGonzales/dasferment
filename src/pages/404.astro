---
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SeoHead from '../components/SeoHead.astro';
import '../styles/global.css';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path}`;
const canonicalPath = '/404/';
const canonicalUrl = Astro.site ? new URL(withBase(canonicalPath), Astro.site).toString() : withBase(canonicalPath);
const description =
	'Diese Seite ist nicht im Kodex verzeichnet. Zurück zur Startseite, zu allen Rezepten oder in die Kategorien von Das Ferment.';
---

<!doctype html>
<html lang="de">
	<head>
		<SeoHead
			title="Seite nicht gefunden | Das Ferment"
			description={description}
			canonicalUrl={canonicalUrl}
			base={base}
			noindex
		/>
	</head>
	<body>
		<div class="site-shell">
			<Header />

			<main class="recipe-main prose-page">
				<article class="prose-article">
					<header class="prose-intro">
						<p class="section-heading__kicker">Verirrt im Kodex</p>
						<h1>Dieses Blatt fehlt</h1>
						<p class="prose-intro__lead">
							Die gesuchte Seite ist nicht verzeichnet. Vielleicht trägt sie einen anderen Namen, oder sie wurde aus
							dem Kodex gestrichen.
						</p>
					</header>

					<nav class="error-links" aria-label="Wege zurück">
						<a class="button" href={withBase('/')}>Zur Startseite</a>
						<a class="text-link" href={withBase('/rezepte/')}>Alle Rezepte</a>
						<a class="text-link" href={withBase('/kategorien/')}>Kategorien</a>
						<a class="text-link" href={withBase('/wissen/')}>Wissen</a>
					</nav>
				</article>
			</main>

			<Footer />
		</div>
	</body>
</html>
