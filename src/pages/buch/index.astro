---
import { getImage, Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import epubIcon from "../../pic/icons/epub.png";
import pdfIcon from "../../pic/icons/pdf.png";
import buchIcon from "../../pic/icons/buch.png";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import SeoHead from "../../components/SeoHead.astro";
import { allRecipes } from "../../lib/chapters";
import { coverImageFor } from "../../lib/pageImages";
import { socialCard } from "../../lib/social";
import "../../styles/global.css";

const recipes = allRecipes;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const withBase = (path: string) => `${base}${path}`;
const canonicalPath = "/buch/";
const canonicalUrl = Astro.site
	? new URL(withBase(canonicalPath), Astro.site).toString()
	: withBase(canonicalPath);
const absoluteUrl = (path: string) =>
	Astro.site ? new URL(path, Astro.site).toString() : path;
const description = `Das Ferment als PDF und E-Book (EPUB) – mit den ${recipes.length} Rezepten und Illustrationen aus dem Kodex.`;

// Die Dateien werden in .github/workflows/buch-pdf.yml gebaut und liegen im
// Release „buch“. Sie gehören nicht ins Repository und nicht in den Site-Build.
const releaseUrl =
	"https://github.com/DrGonzales/dasferment/releases/download/buch";
const downloads = [
	{
		href: `${releaseUrl}/das-ferment.pdf`,
		label: "PDF herunterladen",
		format: "PDF",
		note: "Für Druck und Archiv",
		icon: pdfIcon,
	},
	{
		href: `${releaseUrl}/das-ferment.epub`,
		label: "EPUB herunterladen",
		format: "EPUB",
		note: "Für E-Reader und unterwegs",
		icon: epubIcon,
	},
];

const cover = coverImageFor(recipes);
const cardImage = await socialCard(
	(options) => getImage({ ...options, src: cover as ImageMetadata }),
	cover
		? {
				width: cover.width,
				height: cover.height,
				alt: "Buchmalerei aus dem Kodex von Das Ferment",
			}
		: undefined,
	absoluteUrl,
);
---

<!doctype html>
<html lang="de">
	<head>
		<SeoHead
			title="Von Büchern, Pergament und großer Fermentierlust"
			description={description}
			canonicalUrl={canonicalUrl}
			base={base}
			image={cardImage}
			breadcrumbs={[
				{ name: "Startseite", path: "/" },
				{ name: "Buch", path: canonicalPath },
			]}
		/>
	</head>
	<body>
		<div class="site-shell">
			<Header />

			<main class="recipe-main prose-page book-page">
				<nav class="breadcrumbs" aria-label="Brotkrümelnavigation">
					<a href={withBase("/")}>Startseite</a>
					<span aria-hidden="true">/</span>
					<span aria-current="page">Buch</span>
				</nav>

				<article class="prose-article">
					<header class="prose-intro book-intro">
						<figure class="book-intro__motiv">
							<Image
								src={buchIcon}
								alt=""
								aria-hidden="true"
								width={384}
								height={384}
								quality={80}
								loading="eager"
								decoding="async"
							/>
						</figure>
						<h1>Von Büchern und Pergament</h1>
					</header>

					<div class="prose-section">
						<p class="prose-intro__lead">
							Wohlan, liebe Freunde der gärenden Köstlichkeiten!
							Wer Das Ferment nicht allein auf dem Bildschirm
							bestaunen, sondern auch fernab der Schreibstube in
							Händen halten oder auf Reisen mit sich führen
							möchte, dem sei frohe Kunde verkündet!
						</p>
						<p>
							Connie und Katze haben mit großer Freude und manch
							blubberndem Abenteuer ihre Rezepte und Erkenntnisse
							in diesem Werke zusammengetragen. Und damit kein
							Liebhaber der edlen Gärkunst darben muss, gibt es
							Das Ferment auch als PDF und E-Book (EPUB).
						</p>
						<p>
							Ob auf dem Bildschirm, im E-Reader oder fein
							säuberlich ausgedruckt auf Papier – so möget Ihr
							jederzeit in die wundersame Welt der Fermente
							eintauchen.
						</p>
						<p>
							Connie und Katze wünschen Euch viel Freude beim
							Schmökern, Rühren, Würzen und fröhlichen Blubbern!
						</p>

						<div class="download-list">
							{
								downloads.map((download) => (
									<a
										class="download"
										href={download.href}
										target="_blank"
										rel="noopener noreferrer"
									>
										<Image
											class="download__icon"
											src={download.icon}
											alt=""
											aria-hidden="true"
											width={192}
											quality={80}
											loading="lazy"
											decoding="async"
										/>
										<span class="download__body">
											<span class="download__format">
												{download.format}
											</span>
											<span class="download__label">
												{download.label}
											</span>
											<span class="download__note">
												{download.note}
											</span>
										</span>
									</a>
								))
							}
						</div>
					</div>
				</article>
			</main>

			<Footer />
		</div>
	</body>
</html>
