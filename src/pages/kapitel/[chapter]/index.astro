---
import { getImage, Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import ChapterNav from '../../../components/ChapterNav.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import SeoHead from '../../../components/SeoHead.astro';
import {
	chapterKnowledgePath,
	chapterPath,
	chapterRecipesPath,
	chapters,
	type Chapter,
} from '../../../lib/chapters';
import { socialCard } from '../../../lib/social';
import '../../../styles/global.css';

export function getStaticPaths() {
	return chapters.map((chapter) => ({
		params: { chapter: chapter.slug },
		props: { chapter },
	}));
}

interface Props {
	chapter: Chapter;
}

const { chapter } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path}`;
const canonicalPath = chapterPath(chapter);
const canonicalUrl = Astro.site
	? new URL(withBase(canonicalPath), Astro.site).toString()
	: withBase(canonicalPath);
const description = chapter.beschreibung;
const absoluteUrl = (path: string) =>
	Astro.site ? new URL(path, Astro.site).toString() : path;
const cardImage = chapter.image
	? await socialCard(
			(options) =>
				getImage({ ...options, src: chapter.image as ImageMetadata }),
			{
				width: chapter.image.width,
				height: chapter.image.height,
				alt: `Kapitelbild zu ${chapter.titel}`,
			},
			absoluteUrl,
		)
	: undefined;
---

<!doctype html>
<html lang="de">
	<head>
		<SeoHead
			title={`${chapter.titel} | Das Ferment`}
			description={description}
			canonicalUrl={canonicalUrl}
			base={base}
			image={cardImage}
			breadcrumbs={[
				{ name: 'Kapitelübersicht', path: '/' },
				{ name: chapter.titel, path: canonicalPath },
			]}
		/>
	</head>
	<body>
		<div class="site-shell">
			<Header />

			<main class="repertoire chapter-page">
				<ChapterNav chapter={chapter} />

				<section class="chapter-intro" aria-labelledby="chapter-title">
					{
						chapter.image && (
							<figure class="chapter-intro__figure">
								<Image
									src={chapter.image}
									alt={`Kapitelbild zu ${chapter.titel}`}
									widths={[320, 480, 640, 780]}
									sizes="(max-width: 780px) calc(100vw - 40px), 34vw"
									format="webp"
									quality={78}
									loading="eager"
									fetchpriority="high"
									decoding="async"
								/>
							</figure>
						)
					}

					<div class="chapter-intro__copy">
						<p class="section-heading__kicker">Kapitel im Kodex</p>
						<h1 id="chapter-title">{chapter.titel}</h1>
						<p class="chapter-intro__lead">{chapter.beschreibung}</p>
						<p class="chapter-intro__count">
							{chapter.recipes.length} Rezepte und {chapter.infos.length} Wissenseinträge.
						</p>
						<div class="chapter-intro__actions">
							<a class="button" href={withBase(chapterRecipesPath(chapter))}>
								Rezepte öffnen
							</a>
							<a class="text-link" href={withBase(chapterKnowledgePath(chapter))}>
								Wissen lesen
							</a>
						</div>
					</div>
				</section>
			</main>

			<Footer />
		</div>
	</body>
</html>
