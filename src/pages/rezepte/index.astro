---
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import recipeData from '../../data/das_ferment.json';
import RecipeCard from '../../components/RecipeCard.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import SeoHead from '../../components/SeoHead.astro';
import { coverImageFor, imageForRecipe } from '../../lib/pageImages';
import { socialCard } from '../../lib/social';
import { recipeImageAlt, type Recipe } from '../../lib/recipes';
import '../../styles/global.css';

const recipes = recipeData as Recipe[];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path}`;
const illustratedCount = recipes.filter((recipe) => imageForRecipe(recipe)).length;
const description = `Alle ${recipes.length} Rezepte aus dem Kodex von Das Ferment – mit Zutaten, Zubereitung und ${illustratedCount} Buchmalereien.`;
const canonicalPath = '/rezepte/';
const canonicalUrl = Astro.site ? new URL(withBase(canonicalPath), Astro.site).toString() : withBase(canonicalPath);
const absoluteUrl = (path: string) => Astro.site ? new URL(path, Astro.site).toString() : path;
const cover = coverImageFor(recipes);
const cardImage = await socialCard(
	(options) => getImage({ ...options, src: cover as ImageMetadata }),
	cover
		? {
				width: cover.width,
				height: cover.height,
				alt: 'Buchmalerei aus dem Kodex von Das Ferment',
			}
		: undefined,
	absoluteUrl,
);
---

<!doctype html>
<html lang="de">
	<head>
		<SeoHead
			title="Rezepte | Das Ferment"
			description={description}
			canonicalUrl={canonicalUrl}
			base={base}
			image={cardImage}
		/>
	</head>
	<body>
		<div class="site-shell">
			<Header />

			<main class="repertoire recipes-index">
				<nav class="breadcrumbs" aria-label="Brotkrümelnavigation">
					<a href={withBase('/')}>Startseite</a>
					<span aria-hidden="true">/</span>
					<span aria-current="page">Rezepte</span>
				</nav>

				<header class="section-heading">
					<div>
						<p class="section-heading__kicker">Das Repertoire</p>
						<h1 id="rezepte-title">Im Kodex verzeichnet</h1>
					</div>
					<p class="section-heading__count">
						{recipes.length} Rezepte, nach den Namen ihrer Blätter geordnet. Wähle ein Rezept und folge seinem Gärweg.
					</p>
				</header>

				<div class="recipe-grid" aria-labelledby="rezepte-title">
					{recipes.map((recipe, index) => (
						<RecipeCard
							recipe={recipe}
							image={imageForRecipe(recipe)}
							index={index}
							total={recipes.length}
						/>
					))}
				</div>
			</main>

			<Footer />
		</div>
	</body>
</html>
