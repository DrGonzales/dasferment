---
import type { ImageMetadata } from "astro";
import { getImage, Image } from "astro:assets";
import recipeData from "../../data/das_ferment.json";
import Footer from "../../components/Footer.astro";
import Header from "../../components/Header.astro";
import SeoHead from "../../components/SeoHead.astro";
import { imageForRecipe } from "../../lib/pageImages";
import { actorImageFor } from "../../lib/actorImages";
import { socialCard } from "../../lib/social";
import { recipeDescription } from "../../lib/seo";
import {
	categorySlug,
	GENERAL_TAG_LABEL,
	hasGeneralTag,
	recipeImageAlt,
	relatedRecipes,
	slugify,
	totalTimeIso,
	type Recipe,
} from "../../lib/recipes";
import "../../styles/global.css";

export function getStaticPaths() {
	const pathRecipes = recipeData as Recipe[];

	return pathRecipes.map((recipe) => ({
		params: { slug: slugify(recipe.titel) },
		props: { recipe },
	}));
}

interface Props {
	recipe: Recipe;
}

const { recipe } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const withBase = (path: string) => `${base}${path}`;
const slug = slugify(recipe.titel);
const canonicalPath = `/rezepte/${slug}/`;
const canonicalUrl = Astro.site
	? new URL(withBase(canonicalPath), Astro.site).toString()
	: withBase(canonicalPath);
const description = recipeDescription(recipe);
const related = relatedRecipes(recipe, recipeData as Recipe[]);
// Ab etwa 60 Zeichen schneidet die Suche den Titel ab. Dann entfällt der
// Markenzusatz, der Name steht ohnehin in den WebSite-Daten und im Kopf jeder Seite.
const pageTitle = `${recipe.titel} | Das Ferment`;
const title = pageTitle.length > 60 ? recipe.titel : pageTitle;
const image = imageForRecipe(recipe);
const advisorImage = recipe.ratgeber
	? actorImageFor(recipe.ratgeber.sprecher)
	: undefined;
const absoluteUrl = (path: string) =>
	Astro.site ? new URL(path, Astro.site).toString() : path;
const homeUrl = absoluteUrl(withBase("/"));
const cardImage = await socialCard(
	(options) => getImage({ ...options, src: image as ImageMetadata }),
	image
		? { width: image.width, height: image.height, alt: recipeImageAlt(recipe) }
		: undefined,
	absoluteUrl,
);
const jsonLdImages = image
	? await Promise.all(
			[800, 1200].map(async (width) => {
				const rendered = await getImage({
					src: image,
					width,
					format: "webp",
					quality: 80,
				});
				return {
					"@type": "ImageObject",
					url: absoluteUrl(rendered.src),
					width,
					height: Math.round((width * image.height) / image.width),
				};
			}),
		)
	: undefined;
const siteOrganization = {
	"@type": "Organization",
	name: "Das Ferment",
	url: homeUrl,
};
const recipeJsonLd = {
	"@context": "https://schema.org",
	"@type": "Recipe",
	name: recipe.titel,
	description,
	image: jsonLdImages,
	inLanguage: "de",
	url: canonicalUrl,
	mainEntityOfPage: { "@type": "WebPage", "@id": canonicalUrl },
	author: siteOrganization,
	publisher: siteOrganization,
	totalTime: totalTimeIso(recipe),
	recipeCategory: hasGeneralTag(recipe) ? GENERAL_TAG_LABEL : undefined,
	keywords: recipe.tags.join(", "),
	recipeIngredient: recipe.zutaten,
	recipeInstructions: recipe.zubereitung.map((step) => ({
		"@type": "HowToStep",
		text: step,
	})),
};
const breadcrumbTrail = [
	{ name: "Startseite", path: "/" },
	{ name: "Rezepte", path: "/rezepte/" },
	{ name: recipe.titel, path: canonicalPath },
];
---

<!doctype html>
<html lang="de">
	<head>
		<SeoHead
			title={title}
			description={description}
			canonicalUrl={canonicalUrl}
			base={base}
			image={cardImage}
			type="article"
			breadcrumbs={breadcrumbTrail}
			jsonLd={[recipeJsonLd]}
		/>
	</head>
	<body>
		<div class="site-shell">
			<Header />

			<main class="recipe-main">
				<nav class="breadcrumbs" aria-label="Brotkrümelnavigation">
					<a href={withBase("/")}>Startseite</a>
					<span aria-hidden="true">/</span>
					<a href={withBase("/rezepte/")}>Rezepte</a>
					<span aria-hidden="true">/</span>
					<span aria-current="page">{recipe.titel}</span>
				</nav>

				<article class="recipe-article">
					<header class="recipe-intro">
						<div class="recipe-intro__copy">
							<div class="codex-kicker">
								<span aria-hidden="true">Kodex</span>
								<span aria-hidden="true">·</span>
								<span>Blatt aus dem Rezeptbuch</span>
							</div>

							<h1>
								{recipe.codex_titel}
							</h1>
							<p class="recipe-intro__recipe-title">{recipe.titel}</p>
							{
								recipe.codex_einleitung && (
									<p class="recipe-intro__lead">
										{recipe.codex_einleitung}
									</p>
								)
							}
							<nav
								class="recipe-intro__tags"
								aria-label="Rezeptkategorien"
							>
								{recipe.tags.map((tag) => (
									<a
										href={withBase(`/kategorien/${categorySlug(tag)}/`)}
									>
										{tag}
									</a>
								))}
							</nav>
						</div>

						<div class="recipe-intro__image">
							{
								image ? (
									<figure>
										<Image
											src={image}
											alt={recipeImageAlt(recipe)}
											widths={[320, 480, 640, 780, 1024]}
											sizes="(max-width: 520px) calc(100vw - 40px), 480px"
											quality={78}
											loading="eager"
											fetchpriority="high"
											decoding="async"
										/>
										<figcaption>
											Eine Buchmalerei zu diesem Blatt
										</figcaption>
									</figure>
								) : (
									<div
										class="recipe-image-placeholder"
										aria-hidden="true"
									>
										<span>Kodex</span>
										<i />
									</div>
								)
							}
						</div>
					</header>

					<div class="recipe-sections">
						<section
							class="recipe-section recipe-section--ingredients"
							aria-labelledby="zutaten-title"
						>
							<header class="recipe-section__header">
								<p class="section-heading__kicker">
									Was hinein gehört
								</p>
								<h2 id="zutaten-title">Zutaten</h2>
							</header>
							<ul class="ingredient-list">
								{
									recipe.zutaten.map((ingredient) => (
										<li>{ingredient}</li>
									))
								}
							</ul>
						</section>

						<section
							class="recipe-section recipe-section--instructions"
							aria-labelledby="zubereitung-title"
						>
							<header class="recipe-section__header">
								<p class="section-heading__kicker">
									Der Gang der Gärung
								</p>
								<h2 id="zubereitung-title">Zubereitung</h2>
							</header>
							<ol class="instruction-list">
								{
									recipe.zubereitung.map((step) => (
										<li>{step}</li>
									))
								}
							</ol>
						</section>
					</div>

					{
						recipe.ratgeber && (
							<aside
								class="recipe-advisor"
								aria-label={`Ratschlag von ${recipe.ratgeber.sprecher}`}
							>
								<div class="recipe-advisor__content">
									{
										advisorImage && (
											<figure class="recipe-advisor__portrait">
												<Image
													src={advisorImage}
													alt={`${recipe.ratgeber.sprecher} in der Schreibkammer`}
													widths={[160, 320, 480]}
													sizes="(max-width: 780px) 5.5rem, 8rem"
													quality={80}
													loading="lazy"
													decoding="async"
												/>
											</figure>
										)
									}
									<div class="recipe-advisor__text">
										<div class="recipe-advisor__heading">
											<span
												class="recipe-advisor__ornament"
												aria-hidden="true"
											>
												✦
											</span>
											<h2>
												{recipe.ratgeber.sprecher}s Ratschlag
											</h2>
											<span
												class="recipe-advisor__ornament"
												aria-hidden="true"
											>
												✦
											</span>
										</div>
										<blockquote>
											„{recipe.ratgeber.text}“
										</blockquote>
									</div>
								</div>
							</aside>
						)
					}
					{
						related.length > 0 && (
							<section
								class="recipe-related"
								aria-labelledby="verwandte-title"
							>
								<header class="recipe-section__header">
									<p class="section-heading__kicker">
										Weiter im Kodex
									</p>
									<h2 id="verwandte-title">Verwandte Rezepte</h2>
								</header>
								<ul class="recipe-related__list">
									{related.map((entry) => {
										const relatedImage = imageForRecipe(entry);
										return (
											<li>
												<a
													href={withBase(`/rezepte/${slugify(entry.titel)}/`)}
												>
													<div class="recipe-related__visual">
														{relatedImage ? (
															<Image
																src={relatedImage}
																alt={recipeImageAlt(entry)}
																widths={[220, 280, 360, 480]}
																sizes="(max-width: 520px) calc(100vw - 80px), (max-width: 880px) 44vw, 280px"
																quality={74}
																loading="lazy"
																decoding="async"
															/>
														) : (
															<div
																class="recipe-related__placeholder"
																aria-hidden="true"
															/>
														)}
													</div>
													<span class="recipe-related__codex">
														{entry.codex_titel}
													</span>
													<span class="recipe-related__plain">
														{entry.titel}
													</span>
												</a>
											</li>
										);
									})}
								</ul>
							</section>
						)
					}
				</article>
			</main>

			<Footer />
		</div>
	</body>
</html>
