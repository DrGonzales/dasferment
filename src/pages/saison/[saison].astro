---
import SkipLink from '../../components/SkipLink.astro';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import RecipeCard from '../../components/RecipeCard.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import SeoHead from '../../components/SeoHead.astro';
import { infoPath, recipePath } from '../../lib/chapters';
import {
	landingInfos,
	landingPages,
	seasonalRecipes,
	withCount,
	type LandingPage,
} from '../../lib/landingPages';
import { coverImageFor, imageForRecipe } from '../../lib/pageImages';
import { recipeImageAlt } from '../../lib/recipes';
import { socialCard } from '../../lib/social';
import '../../styles/global.css';

export function getStaticPaths() {
	return landingPages
		.filter((page) => page.typ === 'saison')
		.map((page) => ({
			params: { saison: page.slug },
			props: { landing: page },
		}));
}

interface Props {
	landing: LandingPage;
}

const { landing } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path}`;
const canonicalPath = landing.route;
const canonicalUrl = Astro.site
	? new URL(withBase(canonicalPath), Astro.site).toString()
	: withBase(canonicalPath);
const recipes = seasonalRecipes(landing);
const wissen = landingInfos(landing);
const title = withCount(landing.title, recipes.length);
const description = withCount(landing.description, recipes.length);
const recipeItems = recipes.map((recipe) => ({
	name: recipe.titel,
	path: recipePath(recipe),
}));
const absoluteUrl = (path: string) =>
	Astro.site ? new URL(path, Astro.site).toString() : path;
const coverRecipe = recipes.find((recipe) => imageForRecipe(recipe));
const cover = coverImageFor(recipes);
const cardImage = await socialCard(
	(options) => getImage({ ...options, src: cover as ImageMetadata }),
	cover && coverRecipe
		? {
				width: cover.width,
				height: cover.height,
				alt: recipeImageAlt(coverRecipe),
			}
		: undefined,
	absoluteUrl,
);
---

<!doctype html>
<html lang="de">
	<head>
		<SeoHead
			title={title}
			description={description}
			canonicalUrl={canonicalUrl}
			base={base}
			image={cardImage}
			breadcrumbs={[
				{ name: 'Startseite', path: '/' },
				{ name: landing.h1, path: canonicalPath },
			]}
			itemList={{ name: landing.h1, items: recipeItems }}
		/>
	</head>
	<body>
		<SkipLink />
		<div class="site-shell">
			<Header />

			<main id="main" class="repertoire saison-page">
				<nav class="breadcrumbs" aria-label="Brotkrümelnavigation">
					<a href={withBase('/')}>Startseite</a>
					<span aria-hidden="true">/</span>
					<span aria-current="page">{landing.h1}</span>
				</nav>

				<header class="section-heading">
					<div>
						<p class="section-heading__kicker">{landing.kicker}</p>
						<h1 id="saison-title">{landing.h1}</h1>
					</div>
					<p class="section-heading__count">
						{recipes.length} Rezepte für diese Jahreszeit.
					</p>
				</header>

				<div class="landing-intro">
					<p>{landing.lead}</p>
				</div>

				<div class="recipe-grid" aria-labelledby="saison-title">
					{recipes.map((recipe, index) => (
						<RecipeCard
							recipe={recipe}
							image={imageForRecipe(recipe)}
							index={index}
							total={recipes.length}
						/>
					))}
				</div>

				{wissen.length > 0 && (
					<nav class="landing-wissen" aria-label="Wissen zur Jahreszeit">
						<p class="section-heading__kicker">Aus dem Wissensteil</p>
						<ul>
							{wissen.map((info) => (
								<li>
									<a class="prose-link" href={withBase(infoPath(info))}>
										{info.titel}
										<span class="prose-link__arrow" aria-hidden="true">↗</span>
									</a>
								</li>
							))}
						</ul>
					</nav>
				)}
			</main>

			<Footer />
		</div>
	</body>
</html>
