---
import { Image } from 'astro:assets';
import recipeData from '../../data/das_ferment.json';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import SeoHead from '../../components/SeoHead.astro';
import { actorImageFor } from '../../lib/actorImages';
import { FIGUREN } from '../../lib/figuren';
import { type Recipe } from '../../lib/recipes';
import '../../styles/global.css';

const recipes = recipeData as Recipe[];
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path}`;
const illustratedCount = recipes.filter((recipe) => recipe.picture).length;
const categoryCount = new Set(recipes.flatMap((recipe) => recipe.tags)).size;
const figuren = FIGUREN.map((figur) => ({
	...figur,
	image: actorImageFor(figur.sprecher),
}));
const canonicalPath = '/ueber-diese-seite/';
const canonicalUrl = Astro.site ? new URL(withBase(canonicalPath), Astro.site).toString() : withBase(canonicalPath);
const description = `Lerne das statische Rezeptbuch Das Ferment und seine ${recipes.length} Rezepte im Kodex kennen.`;
---

<!doctype html>
<html lang="de">
	<head>
		<SeoHead
			title="Über diese Seite | Das Ferment"
			description={description}
			canonicalUrl={canonicalUrl}
			base={base}
		/>
	</head>
	<body>
		<div class="site-shell">
			<Header />

			<main class="recipe-main prose-page">
				<nav class="breadcrumbs" aria-label="Brotkrümelnavigation">
					<a href={withBase('/')}>Startseite</a>
					<span aria-hidden="true">/</span>
					<span aria-current="page">Über diese Seite</span>
				</nav>

				<article class="prose-article">
					<header class="prose-intro">
						<p class="section-heading__kicker">Ein Wort zum Haus</p>
						<h1>Über diese Seite</h1>
						<p class="prose-intro__lead">Ein spielerischer Fermentations-Kodex, erzählt von Connie und Katze.</p>
					</header>

					{
						figuren.map((figur) => (
							<section class="prose-section" aria-labelledby={`${figur.id}-titel`}>
								<p class="section-heading__kicker">{figur.kicker}</p>
								<h2 id={`${figur.id}-titel`}>{figur.name}</h2>
								<div class="prose-figure">
									{figur.image && (
										<figure class="prose-figure__portrait">
											<Image
												src={figur.image}
												alt={`${figur.sprecher} in der Schreibkammer`}
												widths={[192, 288, 384]}
												sizes="(max-width: 560px) 6rem, 9rem"
												quality={80}
												loading="lazy"
												decoding="async"
											/>
										</figure>
									)}
									<div>
										{figur.abschnitte.map((abschnitt) => (
											<p>{abschnitt}</p>
										))}
									</div>
								</div>
							</section>
						))
					}

					<section class="prose-section" aria-labelledby="werk-title">
						<p class="section-heading__kicker">Der Kodex</p>
						<h2 id="werk-title">Das Werk</h2>
						<p>
							Das Werk ist ein spielerischer Fermentations-Kodex, der traditionelle und moderne Gemüsefermente in einer mittelalterlich anmutenden Welt präsentiert. Grundlage bildet eine Sammlung von {recipes.length} Rezepten für fermentiertes Gemüse, von klassischen Salzgurken und Sauerkraut über Kimchi bis hin zu Fermenten aus Karotten, Roter Bete, Paprika, Zwiebeln, Fenchel, Sellerie, Kohlrabi, Zucchini und Kürbis.
						</p>
						<p>
							{illustratedCount} der {recipes.length} Rezepte sind mit einer Buchmalerei versehen. Die {categoryCount} Kategorien geben einen weiteren Weg durch das Repertoire.
						</p>
					</section>

					<aside class="prose-note">
						<span aria-hidden="true">❦</span>
						<p>Geduld ist das eigentliche Gewürz.</p>
					</aside>
				</article>
			</main>

			<Footer />
		</div>
	</body>
</html>
