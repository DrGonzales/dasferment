---
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const withBase = (path: string) => `${base}${path}`;
---

<footer class="site-footer">
	<a class="site-footer__back" href={withBase('/')}>Zur Startseite</a>
	<p>Das Ferment · Ein statisches Rezeptbuch</p>
	<a class="site-footer__back" href={withBase('/impressum/')}>Impressum</a>
</footer>
