---
import type { ImageMetadata } from 'astro';
import { getImage } from 'astro:assets';
import { actorImageFor } from '../../lib/actorImages';
import {
	BOOK_SUBTITLE,
	BOOK_TITLE,
	bookRegister,
	bookSections,
	contentsAnchor,
	figurenAnchor,
	groupAnchor,
	infoAnchor,
	prefaceAnchor,
	registerAnchor,
} from '../../lib/book';
import { allInfos as infos, allRecipes as recipes, chapters as chapterConfigs } from '../../lib/chapters';
import { FIGUREN } from '../../lib/figuren';
import { codexListe, codexText } from '../../lib/infos';
import { imageForRecipe } from '../../lib/pageImages';
import { recipeImageAlt } from '../../lib/recipes';
import { assignPortraits } from '../../lib/smallActors';
import { hyphenate } from '../hyphenate';
import '../styles/book.css';

// Das Bild füllt die ganze Seite: 154 mm Breite auf dem Beschnitt. Bei 768 px
// wären das nur rund 127 dpi, also geht das Motiv in der vollen Quellenbreite
// von 1024 px ins PDF, rund 169 dpi.
const RECIPE_IMAGE_WIDTH = 1024;
const CHAPTER_IMAGE_WIDTH = 768;
const ADVISOR_IMAGE_WIDTH = 224;
const PORTRAIT_IMAGE_WIDTH = 224;
const FIGUREN_IMAGE_WIDTH = 384;
const IMAGE_QUALITY = 80;

const sections = bookSections(chapterConfigs);
const register = bookRegister(sections.flatMap((section) => section.recipes));
const gruppenAnzahl = sections.reduce((summe, section) => summe + section.gruppen.length, 0);
const portraitById = new Map<string, ImageMetadata | undefined>();
for (const config of chapterConfigs) {
	const portraits = assignPortraits(config.infos, config.slug);
	config.infos.forEach((info, index) => portraitById.set(info.id, portraits[index]));
}

type Bildformat = 'jpeg' | 'png';

interface RenderedImage {
	src: string;
	width: number;
	height: number;
}

const rendered = new Map<string, Promise<RenderedImage>>();

// Ohne Enlargement bleiben die Quellbilder das Dach. Jedes Motiv wird einmal
// gerendert und dann mehrfach benutzt, sonst rechnet sharp dieselbe Datei
// neununddreißigmal neu.
function renderImage(
	image: ImageMetadata,
	width: number,
	format: Bildformat = 'jpeg',
): Promise<RenderedImage> {
	const key = `${image.src}-${width}-${format}`;
	const pending = rendered.get(key);

	if (pending) return pending;

	const promise = getImage({
		src: image,
		width: Math.min(width, image.width),
		format,
		quality: IMAGE_QUALITY,
	}).then(
		(result) => ({
			src: result.src,
			width: result.attributes.width,
			height: result.attributes.height,
		}),
	);

	rendered.set(key, promise);
	return promise;
}

const renderedSections = await Promise.all(
	sections.map(async (section) => ({
		...section,
		image: section.config.image
			? await renderImage(section.config.image, CHAPTER_IMAGE_WIDTH)
			: undefined,
		recipes: await Promise.all(
			section.recipes.map(async (folio) => {
				const image = imageForRecipe(folio.recipe);
				const advisor = folio.recipe.ratgeber
					? actorImageFor(folio.recipe.ratgeber.sprecher, folio.recipe.kapitel)
					: undefined;

				return {
					...folio,
					image: image ? await renderImage(image, RECIPE_IMAGE_WIDTH) : undefined,
					advisorImage: advisor
						? await renderImage(advisor, ADVISOR_IMAGE_WIDTH)
						: undefined,
				};
			}),
		),
	})),
);

// Die Wissensmotive liegen als PNG mit transparentem Grund vor. Als JPEG
// verliert sharp diese Durchsichtigkeit und füllt sie schwarz, deshalb bleiben
// sie hier PNG und zeigen das Pergament durch.
const knowledgePortraits = await Promise.all(
	infos.map(async (info) => {
		const portrait = portraitById.get(info.id);
		return portrait ? await renderImage(portrait, PORTRAIT_IMAGE_WIDTH, 'png') : undefined;
	}),
);

// Die beiden Gestalten stehen im Buch nach dem Vorwort, im hohen Format wie
// beim Ratschlag. actors/* ist deckend, deshalb JPEG.
const figuren = await Promise.all(
	FIGUREN.map(async (figur) => {
		const image = actorImageFor(figur.sprecher, chapterConfigs[0]?.slug);
		return { ...figur, image: image ? await renderImage(image, FIGUREN_IMAGE_WIDTH) : undefined };
	}),
);

const contents = [
	{ ref: prefaceAnchor(), label: 'Vorwort: Was die Geduld lehrt', indent: 0 },
	{ ref: figurenAnchor(), label: 'Connie und Katze', indent: 0 },
	...renderedSections.flatMap((section) => [
		{
			ref: section.anchor,
			label: section.config.titel,
			indent: 0,
		},
		...section.recipes.map((folio) => ({
			ref: folio.anchor,
			label: folio.recipe.codex_titel,
			indent: 1,
		})),
		...section.gruppen.map((gruppe) => ({
			ref: groupAnchor(gruppe.slug, section.config.slug),
			label: gruppe.label,
			indent: 1,
		})),
	]),
	{ ref: registerAnchor(), label: 'Register der Rezepte', indent: 0 },
];
---

<!doctype html>
<html lang="de">
	<head>
		<meta charset="utf-8" />
		<meta name="author" content="Das Ferment" />
		<meta
			name="description"
			content={`${BOOK_TITLE}, das Rezeptbuch: ${recipes.length} Rezepte und ${infos.length} Einträge rund um die Fermentation.`}
		/>
		<title>{BOOK_TITLE} — {BOOK_SUBTITLE}</title>
	</head>
	<body>
		<section class="book-title">
			<div class="book-title__mark" aria-hidden="true">
				<svg viewBox="0 0 32 32" fill="none">
					<path
						d="M16 27V9M16 19c-5.8 0-9-3.1-10-8 5.7-.6 9.2 1.8 10 8Zm0-5c0-5.5 3.2-8.7 9-9 .1 5.4-2.8 8.6-9 9Z"
						stroke="currentColor"
						stroke-width="1.4"
						stroke-linecap="round"
						stroke-linejoin="round"
					>
				</path>
				</svg>
			</div>
			<h1 class="book-title__name">{BOOK_TITLE}</h1>
			<p class="book-title__subtitle">{BOOK_SUBTITLE}</p>
			<p class="book-title__ornament" aria-hidden="true">❦</p>
			<p class="book-title__claim">
				{recipes.length} Rezepte und {infos.length} Einträge aus dem Wissen, aufgeschrieben
				in den Blättern eines Kodex.
			</p>
		</section>

		<section class="book-contents" id={contentsAnchor()}>
			<h1 class="book-contents__title">Inhalt</h1>
			<ul class="toc-list">
				{
					contents.map((entry) => (
						<li>
							<span
								class="toc-list__label"
								style={entry.indent === 1 ? 'padding-left: 4mm' : undefined}
							>
								{entry.label}
							</span>
							<span class="toc-list__leader" aria-hidden="true" />
							<span class="toc-list__page" data-toc-page={entry.ref}>
								00
							</span>
						</li>
					))
				}
			</ul>
		</section>

		<section class="book-part" id={prefaceAnchor()} data-book-ref={prefaceAnchor()}>
			<p class="book-part__kicker kicker">Vorwort</p>
			<h1 class="book-part__title" data-outline data-outline-ref={prefaceAnchor()}>
				Was die Geduld lehrt
			</h1>
			<p class="book-part__ornament" aria-hidden="true">❦</p>
			<p class="book-part__claim">
				{infos.length} Einträge in {gruppenAnzahl} Gruppen, dazu zwei Tabellen über Salz
				und Lagerung.
			</p>
		</section>

		<section class="gestalten" data-book-ref={figurenAnchor()}>
			<header class="knowledge-group__head" id={figurenAnchor()}>
				<h2 class="knowledge-group__title" data-outline data-outline-ref={figurenAnchor()}>
					Connie und Katze
				</h2>
				<p class="knowledge-group__claim">Die Küchenmeisterin und ihr Gefährte</p>
			</header>

			{
				figuren.map((figur) => (
					<article class="gestalt" id={`gestalt-${figur.id}`}>
						{figur.image && (
							<figure class="gestalt__portrait">
								<img
									src={figur.image.src}
									width={figur.image.width}
									height={figur.image.height}
									alt={`${figur.sprecher} in der Schreibkammer`}
								/>
							</figure>
						)}
						<div class="gestalt__body">
							<p class="gestalt__kicker">{figur.kicker}</p>
							<h3
								class="gestalt__name"
								data-outline
								data-outline-ref={`gestalt-${figur.id}`}
							>
								{figur.name}
							</h3>
							{figur.abschnitte.map((abschnitt) => (
								<p>{hyphenate(abschnitt)}</p>
							))}
						</div>
					</article>
				))
			}
		</section>

		{
			renderedSections.map((section) => {
				const kapitelRef = section.anchor;
				return (
					<Fragment>
						<section
							class="book-part book-chapter"
							id={kapitelRef}
							data-book-ref={kapitelRef}
						>
							<p class="book-part__kicker kicker">Kapitel</p>
							<h1 class="book-part__title" data-outline data-outline-ref={kapitelRef}>
								{hyphenate(section.config.titel)}
							</h1>
							{section.image && (
								<figure class="book-chapter__image">
									<img
										src={section.image.src}
										width={section.image.width}
										height={section.image.height}
										alt={`Kapitelbild zu ${section.config.titel}`}
									/>
								</figure>
							)}
							<p class="book-part__ornament" aria-hidden="true">❦</p>
							<p class="book-part__claim">
								{hyphenate(section.config.beschreibung)}
							</p>
						</section>

						{section.recipes.map((folio) => (
							<Fragment>
								{folio.image && (
									<section class="recipe-plate">
										<figure class="recipe-plate__frame">
											<img
												src={folio.image.src}
												width={folio.image.width}
												height={folio.image.height}
												alt={recipeImageAlt(folio.recipe)}
											/>
										</figure>
									</section>
								)}

								<article class="recipe" data-book-ref={folio.anchor} id={folio.anchor}>
									<header class="recipe__head">
										<p class="recipe__kicker kicker">{folio.categories.join(' · ')}</p>
										<h2 class="recipe__heading" data-outline data-outline-ref={folio.anchor}>
											{hyphenate(folio.recipe.codex_titel)}
										</h2>
									</header>

									{folio.recipe.codex_einleitung ? (
										<p class="recipe__intro">{hyphenate(folio.recipe.codex_einleitung)}</p>
									) : null}

									<section class="recipe__ingredients">
										<h3 class="block-title">Zutaten</h3>
										<ul class="ingredient-list">
											{folio.recipe.zutaten.map((zutat) => (
												<li>{hyphenate(zutat)}</li>
											))}
										</ul>
									</section>

									<section class="recipe__method">
										<h3 class="block-title">Zubereitung</h3>
										<ol class="instruction-list">
											{folio.recipe.zubereitung.map((schritt) => (
												<li>{hyphenate(schritt)}</li>
											))}
										</ol>
									</section>

									{folio.recipe.ratgeber && (
										<aside class="recipe-advisor">
											<div class="recipe-advisor__content">
												{folio.advisorImage && (
													<figure class="recipe-advisor__portrait">
														<img
															src={folio.advisorImage.src}
															width={folio.advisorImage.width}
															height={folio.advisorImage.height}
															alt={`${folio.recipe.ratgeber.sprecher} in der Schreibkammer`}
														/>
													</figure>
												)}
												<div class="recipe-advisor__text">
													<div class="recipe-advisor__heading">
														<span class="ornament" aria-hidden="true">
															✦
														</span>
														<h2>{folio.recipe.ratgeber.sprecher}s Ratschlag</h2>
														<span class="ornament" aria-hidden="true">
															✦
														</span>
													</div>
													<blockquote>{hyphenate(folio.recipe.ratgeber.text)}</blockquote>
												</div>
											</div>
										</aside>
									)}
								</article>
							</Fragment>
						))}

						{section.gruppen.map((gruppe) => {
							const gruppenRef = groupAnchor(gruppe.slug, section.config.slug);
							return (
								<section class="knowledge-group" data-book-ref={gruppenRef}>
									<header class="knowledge-group__head" id={gruppenRef}>
										<h2
											class="knowledge-group__title"
											data-outline
											data-outline-ref={gruppenRef}
										>
											{gruppe.label}
										</h2>
										<p class="knowledge-group__claim">
											{gruppe.infos.length}{' '}
											{gruppe.infos.length === 1 ? 'Eintrag' : 'Einträge'}
										</p>
									</header>

									{gruppe.infos.map((info) => {
										const portrait = knowledgePortraits[infos.indexOf(info)];
										return (
											<article
												class="knowledge-entry"
												data-book-ref={infoAnchor(info.id)}
												id={infoAnchor(info.id)}
											>
												<header class="knowledge-entry__head">
													{portrait && (
														<figure class="knowledge-entry__portrait">
															<img
																src={portrait.src}
																width={portrait.width}
																height={portrait.height}
																alt=""
															/>
														</figure>
													)}
													<p class="knowledge-entry__kicker">{info.titel}</p>
													<h3
														data-outline
														data-outline-ref={infoAnchor(info.id)}
													>
														{hyphenate(codexText(info.codex_titel, info.titel))}
													</h3>
												</header>

												<p class="knowledge-entry__intro">
													{hyphenate(codexText(info.codex_intro, info.intro))}
												</p>

												{info.abschnitte?.map((abschnitt) => {
													const liste = codexListe(abschnitt.codex_liste, abschnitt.liste);
													return (
														<section class="knowledge-entry__section">
															<h4>
																{hyphenate(codexText(abschnitt.codex_titel, abschnitt.titel))}
															</h4>
															{abschnitt.text || abschnitt.codex_text ? (
																<p>
																	{hyphenate(
																		codexText(abschnitt.codex_text, abschnitt.text),
																	)}
																</p>
															) : null}
															{liste.length > 0 ? (
																<ul>
																	{liste.map((punkt) => (
																		<li>{hyphenate(punkt)}</li>
																	))}
																</ul>
															) : null}
														</section>
													);
												})}

												{info.tabelle ? (
													<figure class="knowledge-table">
														<table>
															<caption>
																{codexText(
																	info.tabelle.codex_titel,
																	info.tabelle.titel,
																)}
															</caption>
															<thead>
																<tr>
																	{info.tabelle.spalten.map((spalte) => (
																		<th scope="col">{spalte}</th>
																	))}
																</tr>
															</thead>
															<tbody>
																{info.tabelle.zeilen.map((zeile) => (
																	<tr>
																		{zeile.map((zelle, zellenIndex) =>
																			zellenIndex === 0 ? (
																				<th scope="row">{zelle}</th>
																			) : (
																				<td>{zelle}</td>
																			),
																		)}
																	</tr>
																))}
															</tbody>
														</table>
														{info.tabelle.hinweis || info.tabelle.codex_hinweis ? (
															<figcaption>
																{codexText(
																	info.tabelle.codex_hinweis,
																	info.tabelle.hinweis,
																)}
															</figcaption>
														) : null}
													</figure>
												) : null}
											</article>
										);
									})}
								</section>
							);
						})}
					</Fragment>
				);
			})
		}

		<section class="book-part" id={registerAnchor()} data-book-ref={registerAnchor()}>
			<p class="book-part__kicker kicker">Nachschlagen</p>
			<h1 class="book-part__title" data-outline data-outline-ref={registerAnchor()}>
				Register der Rezepte
			</h1>
			<p class="book-part__ornament" aria-hidden="true">❦</p>
			<p class="book-part__claim">
				{register.length} Zutatengruppen, alphabetisch geordnet. Jedes Rezept steht unter
				allen Zutaten, die es trägt.
			</p>
		</section>

		{
			register.map((gruppe) => (
				<section class="register-group">
					<h2 class="register-group__title">{gruppe.label}</h2>
					<ul class="register-group__list">
						{gruppe.entries.map((entry) => (
							<li class="register-entry">
								<span class="register-entry__label">{hyphenate(entry.codexTitel)}</span>
								<span class="register-entry__leader" aria-hidden="true" />
								<span class="register-entry__page" data-toc-page={entry.anchor}>
									00
								</span>
							</li>
						))}
					</ul>
				</section>
			))
		}
	</body>
</html>
